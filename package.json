{
  "name": "prod_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && .venv/bin/python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:up": "bash ./scripts/dev-up.sh",
    "dev:down": "bash ./scripts/dev-down.sh",
    "dev:status": "bash ./scripts/dev-status.sh",
    "perf:seed": "python3 ./performance/scripts/seed_test_data.py",
    "perf:create-task": "bash ./performance/scripts/run-create-task.sh",
    "perf:create-task:1k": "TARGET_RPS=1000 PREALLOCATED_VUS=1000 MAX_VUS=5000 DURATION=30s bash ./performance/scripts/run-create-task.sh",
    "perf:get-board": "bash ./performance/scripts/run-get-board.sh",
    "perf:get-board:1k": "TARGET_RPS=1000 PREALLOCATED_VUS=1000 MAX_VUS=5000 DURATION=30s bash ./performance/scripts/run-get-board.sh",
    "perf:parse-ai": "bash ./performance/scripts/run-parse-ai.sh",
    "perf:parse-ai:1k": "TARGET_RPS=1000 PREALLOCATED_VUS=1000 MAX_VUS=5000 DURATION=30s bash ./performance/scripts/run-parse-ai.sh",
    "perf:cleanup": "python3 ./performance/scripts/cleanup_test_data.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "next": "16.2.9",
    "openai": "^6.47.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
